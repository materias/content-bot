# Telegram bot token from @BotFather
BOT_TOKEN=

# Anthropic API key (yours — the baker never touches this)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# The baker's private numeric chat ID with the bot (see README: Prerequisites)
BAKER_CHAT_ID=

# The channel to publish to: @public_username or the numeric chat id of a private channel
CHANNEL_ID=

# Where the SQLite file lives inside the container (matches the docker-compose volume mount)
DB_PATH=/app/data/bot.db

# IANA timezone the baker is in — controls when POST_TIMES fire
TZ=Europe/Saratov

# Comma-separated 24h HH:mm times (baker-local, per TZ above) to publish the oldest approved post
POST_TIMES=10:00,17:00
